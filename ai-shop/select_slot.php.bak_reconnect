    <?php if ($err): ?>
      <div class="alert alert-danger text-start">
        <i class="bi bi-exclamation-triangle"></i> <?= htmlspecialchars($err) ?>
      </div>
    <?php endif; ?>

    <?php if (empty($grouped)): ?>
      <div class="alert alert-warning text-start">
        <i class="bi bi-hourglass-split"></i>
        No slots available right now. Please try again later.
      </div>
    <?php else: ?>
      <form method="post" class="text-start">
        <?php foreach ($grouped as $date => $daySlots): ?>
          <h6 class="text-muted text-uppercase small mt-3"><?= date('l, d M', strtotime($date)) ?></h6>
          <?php foreach ($daySlots as $s):
            $rem = max(0, (int)$s['capacity'] - (int)$s['booked']);
            if ($rem <= 0) continue;
            if (($s['status'] ?? '') !== 'ACTIVE') continue;
          ?>
            <button type="submit" name="slot_id" value="<?= (int)$s['id'] ?>" class="slot-btn">
              <strong><?= htmlspecialchars($s['range']) ?></strong>
              <div class="small text-muted"><?= $rem ?> slots available</div>
            </button>
          <?php endforeach; ?>
        <?php endforeach; ?>
      </form>
    <?php endif; ?>
