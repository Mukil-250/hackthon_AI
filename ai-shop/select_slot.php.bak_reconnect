<?php
require_once __DIR__ . '/config/db.php';

$orderRef = trim($_GET['order'] ?? '');
if (!$orderRef) die('<h2 style="font-family:system-ui;padding:24px">Missing order ID</h2>');

$HUB_URL     = 'http://172.20.76.71/smarthub';
$HUB_API_KEY = 'ecom_secret_change_me_2026';

$msg = '';
$err = '';
$hideSlots = false;  // Set to true when already booked

if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['slot_id'])) {
    $slotId  = (int)$_POST['slot_id'];
    $payload = json_encode(['order_id' => $orderRef, 'slot_id' => $slotId]);

    $ch = curl_init($HUB_URL . '/api/slots/book.php');
    curl_setopt_array($ch, [
        CURLOPT_POST           => true,
        CURLOPT_POSTFIELDS     => $payload,
        CURLOPT_HTTPHEADER     => ['Content-Type: application/json', 'X-API-KEY: ' . $HUB_API_KEY],
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_TIMEOUT        => 5,
    ]);
    $resp = curl_exec($ch);
    $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);

    $resp = preg_replace('/^\xEF\xBB\xBF/', '', (string)$resp);
    $resp = ltrim($resp);
    $decoded = json_decode($resp, true);

    if ($decoded && !empty($decoded['success'])) {
        $msg = "Slot confirmed! Delivery on " . ($decoded['slot_date'] ?? '') .
               " between " . ($decoded['slot_range'] ?? '');
        $hideSlots = true;
    }
    elseif ($decoded && !empty($decoded['status']) && $decoded['status'] === 'SLOT_CONFIRMED') {
        // Already booked
        $msg = "This order already has a confirmed delivery slot.";
        $hideSlots = true;
    }
    else {
        $err = $decoded['error'] ?? 'Booking failed. Please try again.';
    }
}

// Also check if order already has a booking (page load)
if (!$msg && !$err) {
    $ch = curl_init($HUB_URL . '/api/orders/status.php?order_id=' . urlencode($orderRef));
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_TIMEOUT        => 5,
    ]);
    $ordResp = curl_exec($ch);
    curl_close($ch);

    $ordResp = preg_replace('/^\xEF\xBB\xBF/', '', (string)$ordResp);
    $ordData = json_decode(ltrim($ordResp), true);

    if ($ordData && !empty($ordData['order']['status'])) {
        $currentStatus = $ordData['order']['status'];
        if (in_array($currentStatus, ['SLOT_CONFIRMED','READY_FOR_DISPATCH','RIDER_ASSIGNED','DISPATCHED','OUT_FOR_DELIVERY','DELIVERED'])) {
            $msg = "This order already has a confirmed delivery slot.";
            $hideSlots = true;
        }
    }
}

// Fetch slots from Hub
$grouped = [];
if (!$hideSlots) {
    $ch = curl_init($HUB_URL . '/api/slots/list.php?all=1');
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_TIMEOUT        => 5,
        CURLOPT_HTTPHEADER     => ['X-API-KEY: ' . $HUB_API_KEY],
    ]);
    $slotsResp = curl_exec($ch);
    curl_close($ch);

    $slotsResp = preg_replace('/^\xEF\xBB\xBF/', '', (string)$slotsResp);
    $slotsResp = ltrim($slotsResp);
    $slotsData = json_decode($slotsResp, true);
    $grouped = $slotsData['grouped'] ?? [];
}
?>
