                                id="onlinePayment"
                                value="online"
                                <?= $paymentMethod === 'online' ? 'checked' : '' ?>
                            >

                            <label
                                for="onlinePayment"
                                class="btn btn-outline-primary w-100 p-3"
                            >
                                <i class="bi bi-phone fs-3"></i>
                                <br>
                                <strong>Online Payment</strong>
                                <br>
                                <small>Select a payment app</small>
                            </label>
                        </div>

                    </div>

                    <!-- Online payment providers -->
                    <div
                        id="onlinePaymentOptions"
                        class="mt-4 p-3 border rounded"
                        style="<?= $paymentMethod === 'online' ? '' : 'display:none;' ?>"
                    >
                        <h6 class="mb-3">Choose Payment App</h6>

                        <div class="row g-3">

                            <div class="col-md-4">
                                <input
                                    type="radio"
                                    class="btn-check"
                                    name="payment_provider"
                                    id="paytm"
                                    value="paytm"
                                    <?= $paymentProvider === 'paytm' ? 'checked' : '' ?>
                                >

                                <label
                                    for="paytm"
                                    class="btn btn-outline-primary w-100 p-3"
                                >
                                    <i class="bi bi-wallet2 fs-4"></i>
                                    <br>Paytm
                                </label>
                            </div>

                            <div class="col-md-4">
                                <input
                                    type="radio"
                                    class="btn-check"
                                    name="payment_provider"
                                    id="gpay"
                                    value="gpay"
                                    <?= $paymentProvider === 'gpay' ? 'checked' : '' ?>
                                >

                                <label
                                    for="gpay"
                                    class="btn btn-outline-dark w-100 p-3"
                                >
                                    <i class="bi bi-google fs-4"></i>
                                    <br>Google Pay
                                </label>
