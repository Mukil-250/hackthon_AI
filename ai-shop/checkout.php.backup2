</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const cod = document.getElementById('codPayment');
    const online = document.getElementById('onlinePayment');
    const options = document.getElementById('onlinePaymentOptions');
    const info = document.getElementById('paymentInfo');
    const form = document.getElementById('checkoutForm');

    function updatePaymentDisplay() {
        const isOnline = online.checked;

        options.style.display = isOnline ? 'block' : 'none';
        info.style.display = isOnline ? 'block' : 'none';

        document.querySelectorAll('input[name="payment_provider"]').forEach(function (input) {
            input.required = isOnline;

            if (!isOnline) {
                input.checked = false;
            }
        });
    }

    cod.addEventListener('change', updatePaymentDisplay);
    online.addEventListener('change', updatePaymentDisplay);

    form.addEventListener('submit', function (event) {
        if (online.checked) {
            const selectedProvider = document.querySelector(
                'input[name="payment_provider"]:checked'
            );

            if (!selectedProvider) {
                event.preventDefault();
                alert('Please select Paytm, Google Pay, or PhonePe.');
            }
        }
    });

    updatePaymentDisplay();
});
</script>

<?php require_once __DIR__ . '/includes/footer.php'; ?>