                            <div class="col-md-4">
                                <input
                                    type="radio"
                                    class="btn-check"
                                    name="payment_provider"
                                    id="phonepe"
                                    value="phonepe"
                                    <?= $paymentProvider === 'phonepe' ? 'checked' : '' ?>
                                >

                                <label
                                    for="phonepe"
                                    class="btn btn-outline-danger w-100 p-3"
                                >
                                    <i class="bi bi-phone fs-4"></i>
                                    <br>PhonePe
                                </label>
                            </div>

                        </div>
                    </div>

                    <div
                        id="paymentInfo"
                        class="alert alert-info mt-3"
                        style="<?= $paymentMethod === 'online' ? '' : 'display:none;' ?>"
                    >
