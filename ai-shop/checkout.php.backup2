                <?php endforeach; ?>

                <hr>

                <div class="d-flex justify-content-between">
                    <span>Shipping</span>
                    <span class="text-success">FREE</span>
                </div>

                <div class="d-flex justify-content-between fw-bold fs-5">
                    <span>Total</span>
                    <span><?= h(fmtPrice($total)) ?></span>
