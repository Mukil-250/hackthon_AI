        <div class="card border-0 shadow-sm">
            <div class="card-body">

                <h5 class="card-title mb-3">Shipping Details</h5>

                <form method="post" action="checkout.php" id="checkoutForm">

                    <!-- Phone number -->
                    <div class="mb-3">
                        <label for="phone" class="form-label">
                            Phone Number
                        </label>

                        <input
                            type="tel"
