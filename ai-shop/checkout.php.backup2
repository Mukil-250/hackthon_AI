    <!-- Order summary -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body">

                <h5 class="card-title">Order Summary</h5>

                <?php foreach ($items as $item): ?>
                    <div class="d-flex justify-content-between small mb-2">
                        <span>
                            <?= h($item['name']) ?>
                            &times;
                            <?= (int) $item['quantity'] ?>
                        </span>

                        <span>
                            <?= h(
                                fmtPrice(
                                    (float) $item['price'] *
                                    (int) $item['quantity']
                                )
                            ) ?>
                        </span>
