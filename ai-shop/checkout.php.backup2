                            rows="4"
                            class="form-control"
                            required
                            minlength="10"
                            maxlength="500"
                            placeholder="Name, house no., street, city, state, PIN"
                        ><?= h($address) ?></textarea>
                    </div>

                    <!-- Payment methods -->
                    <h5 class="mb-3">Payment Method</h5>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <input
                                type="radio"
                                class="btn-check"
                                name="payment_method"
                                id="codPayment"
                                value="cod"
                                <?= $paymentMethod === 'cod' ? 'checked' : '' ?>
                                required
                            >

                            <label
                                for="codPayment"
                                class="btn btn-outline-success w-100 p-3"
                            >
                                <i class="bi bi-cash-coin fs-3"></i>
                                <br>
                                <strong>Cash on Delivery</strong>
                                <br>
                                <small>Pay when your order arrives</small>
                            </label>
                        </div>

                        <div class="col-md-6">
                            <input
                                type="radio"
                                class="btn-check"
