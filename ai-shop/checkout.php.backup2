<?php

require_once __DIR__ . '/config/db.php';
require_once __DIR__ . '/includes/functions.php';

if (!isLoggedIn()) {
    header('Location: login.php?redirect=checkout.php');
    exit;
}

$uid = (int) $_SESSION['user_id'];

$items = getCartItems($conn);

if (!$items) {
    header('Location: cart.php?msg=empty');
    exit;
}

$error = '';
$address = '';
$phone = '';
$paymentMethod = 'cod';
$paymentProvider = '';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {

    $address = trim((string) ($_POST['address'] ?? ''));
    $phone = trim((string) ($_POST['phone'] ?? ''));

    $paymentMethod = (string) ($_POST['payment_method'] ?? 'cod');
    $paymentProvider = (string) ($_POST['payment_provider'] ?? '');

    // Validate phone number
    if (!preg_match('/^[0-9]{10}$/', $phone)) {
        $error = 'Please enter a valid 10-digit phone number.';
    }

    // Validate address
    elseif (mb_strlen($address) < 10 || mb_strlen($address) > 500) {
        $error = 'Please enter a complete shipping address (10 to 500 characters).';
    }

    // Validate payment method
    elseif (!in_array($paymentMethod, ['cod', 'online'], true)) {
        $error = 'Please select a valid payment method.';
    }

    // Validate online payment provider
    elseif (
        $paymentMethod === 'online'
        && !in_array($paymentProvider, ['paytm', 'gpay', 'phonepe'], true)
    ) {
        $error = 'Please select Paytm, Google Pay, or PhonePe.';
    }

    if ($error === '') {

        mysqli_report(MYSQLI_REPORT_ERROR | MYSQLI_REPORT_STRICT);

        try {
            $conn->begin_transaction();

            // Read cart and current product prices/stock
            $stmt = $conn->prepare(
                'SELECT c.product_id, c.quantity, p.name, p.price, p.stock
                 FROM cart c
                 JOIN products p ON p.id = c.product_id
                 WHERE c.user_id = ?
                 FOR UPDATE'
            );

            $stmt->bind_param('i', $uid);
            $stmt->execute();

            $lines = $stmt->get_result()->fetch_all(MYSQLI_ASSOC);
            $stmt->close();

            if (!$lines) {
                throw new RuntimeException('Your cart is empty.');
            }

            // Check stock and calculate total
            $total = 0.0;

            foreach ($lines as $line) {
                $quantity = (int) $line['quantity'];
                $stock = (int) $line['stock'];

                if ($quantity < 1 || $quantity > $stock) {
                    throw new RuntimeException(
                        'Not enough stock for "' . $line['name'] .
                        '". Available: ' . $stock .
                        '. Please update your cart.'
                    );
                }

                $total += (float) $line['price'] * $quantity;
            }

            $total = round($total, 2);

            // Save payment provider only for online selections
            $savedProvider = ($paymentMethod === 'online')
                ? $paymentProvider
                : null;

            // Create order with phone and payment details
            $stmt = $conn->prepare(
                'INSERT INTO orders
                    (user_id, total, address, phone, payment_method, payment_provider)
                 VALUES (?, ?, ?, ?, ?, ?)'
            );

            $stmt->bind_param(
                'idssss',
                $uid,
                $total,
                $address,
                $phone,
                $paymentMethod,
                $savedProvider
            );

            $stmt->execute();
            $orderId = (int) $conn->insert_id;
            $stmt->close();

            // Save order items and decrease stock
            $insItem = $conn->prepare(
                'INSERT INTO order_items
                    (order_id, product_id, quantity, price)
                 VALUES (?, ?, ?, ?)'
            );

            $updStock = $conn->prepare(
                'UPDATE products
                 SET stock = stock - ?
                 WHERE id = ? AND stock >= ?'
            );

            foreach ($lines as $line) {
                $pid = (int) $line['product_id'];
                $qty = (int) $line['quantity'];
                $price = (float) $line['price'];

                $insItem->bind_param(
                    'iiid',
                    $orderId,
                    $pid,
                    $qty,
                    $price
                );
                $insItem->execute();

                $updStock->bind_param('iii', $qty, $pid, $qty);
                $updStock->execute();

                if ($updStock->affected_rows !== 1) {
                    throw new RuntimeException(
                        'Stock changed for "' . $line['name'] .
                        '". Please review your cart.'
                    );
                }
            }

            $insItem->close();
            $updStock->close();

            // Empty cart after order creation
            $stmt = $conn->prepare(
                'DELETE FROM cart WHERE user_id = ?'
            );
            $stmt->bind_param('i', $uid);
            $stmt->execute();
            $stmt->close();

            $conn->commit();

            // ============================================================
            // Send order to SlotWise Hub (best-effort, non-blocking)
            // ============================================================
            require_once __DIR__ . '/includes/hub_sender.php';

            // Build products array from the cart lines (still in memory)
            $hubProducts = [];
            foreach ($lines as $line) {
                $hubProducts[] = [
                    'product_id' => (string)($line['product_id'] ?? 'P'),
                    'name'       => $line['name'] ?? 'Product',
                    'qty'        => (int)($line['quantity'] ?? 1),
                    'price'      => (float)($line['price'] ?? 0),
                    'weight'     => 0.5,
                ];
            }

            // Fallback if no products
            if (empty($hubProducts)) {
                $hubProducts[] = [
                    'product_id' => 'ORD' . $orderId,
                    'name'       => 'Order #' . $orderId,
                    'qty'        => 1,
                    'price'      => $total,
                    'weight'     => 0.5,
                ];
            }

            $hubResponse = sendOrderToHub([
                'order_id'         => 'ORD' . $orderId,
                'user_id'          => $uid,
                'customer_name'    => $_SESSION['user_name']  ?? ($_SESSION['name']  ?? 'Customer'),
                'customer_phone'   => $phone,
                'customer_email'   => $_SESSION['user_email'] ?? ($_SESSION['email'] ?? ''),
                'delivery_address' => $address,
                'city'             => 'Tirunelveli',
                'state'            => 'Tamil Nadu',
                'pincode'          => '627002',
                'latitude'         => 8.7139,
                'longitude'        => 77.7567,
                'products'         => $hubProducts,
                'total'            => $total,
                'payment_status'   => ($paymentMethod === 'cod') ? 'COD' : 'PAID',
                'priority'         => 'NORMAL',
            ]);

            error_log('Hub response for ORD' . $orderId . ': ' . json_encode($hubResponse));

            mysqli_report(MYSQLI_REPORT_OFF);

            header('Location: orders.php?success=1');
            exit;

        } catch (Throwable $e) {
            try {
                $conn->rollback();
            } catch (Throwable $ignored) {
                // Ignore rollback errors
            }

            if ($e instanceof RuntimeException) {
                $error = $e->getMessage();
            } else {
                $error = 'Sorry, we could not place your order. Please try again.';
                error_log('Checkout error: ' . $e->getMessage());
            }

            mysqli_report(MYSQLI_REPORT_OFF);

            $items = getCartItems($conn);

            if (!$items) {
                header('Location: cart.php?msg=empty');
                exit;
            }
        }
    }
}

// Calculate display total
$total = 0.0;

foreach ($items as $item) {
    $total += (float) $item['price'] * (int) $item['quantity'];
}

$pageTitle = 'Checkout - AI Shop';
require_once __DIR__ . '/includes/header.php';
?>

<h1 class="h3 mb-3">
    <i class="bi bi-credit-card me-2"></i>Checkout
</h1>

<?php if ($error): ?>
    <div class="alert alert-danger">
        <?= h($error) ?>
        <a href="cart.php" class="alert-link">Back to cart</a>
    </div>
<?php endif; ?>

<div class="row g-4">

    <!-- Checkout form -->
