                        Demo mode: selecting an app does not charge money.
                        Real online payments require payment gateway integration.
                    </div>

                    <button type="submit" class="btn btn-success btn-lg mt-4">
                        <i class="bi bi-check-circle me-2"></i>
                        Place Order
                    </button>

                </form>
            </div>
        </div>
